% Constructs
\newcommand*\com[3]{\{\fv{name}{#1},\:\fv{param}{#2},\:\fv{body}{#3}\}}
\WithSuffix\newcommand\com*[3]{%
  \begin{spreadlines}{0pt}
    \left\{\begin{aligned}
      \field{name} &\colon #1 \\
      \field{param} &\colon #2 \\
      \field{body} &\colon #3
    \end{aligned}\right\}
  \end{spreadlines}%
}
\newcommand*\lfun[2]{\lambda #1.\mskip 1mu#2}
\newcommand*\clos[3]{\<\lfun{#1}{#2}, #3\>}
\newcommand*\phase[1]{\textcolor{RoyalBlue}{\textup{\textsf{#1}}}}
\newcommand*\dec[1]{\textcolor{RedOrange}{\textup{\textsf{\textbf{#1}}}}}
