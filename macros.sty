% Judgements
\newcommand\smallstep{\hookrightarrow}
\newcommand*\Bigstep[2]{\Downarrow^{\scriptscriptstyle #1}_{\scriptscriptstyle #2}}
\WithSuffix\newcommand\Bigstep*[2]{\mathbin{\Overline[\raisebox{1.2ex}{}]{\Downarrow}}^{\scriptscriptstyle #1}_{\scriptscriptstyle #2}}
\newcommand*\Rule[1]{\textup{\textsc{#1}}}

\ExplSyntaxOn
\NewDocumentCommand \Overline { o m }
  {
    \int_compare:nNnTF
      { \str_count:n { #2 } } < 2
      { \overline }
      { \overline }
      {
        \IfNoValueTF { #1 }
          { #2 }
          { \vphantom{#1}\smash{#2} }
      }
  }

\NewDocumentCommand \Step { s D<>{\phi} D<>{p} O{\Sigma, \sigma} m m }
  {
    {#4
    \vdash #5
    \IfBooleanTF { #1 } { \Bigstep* } { \Bigstep }
      { #2 } { #3 }
    #6}
  }
\ExplSyntaxOff
