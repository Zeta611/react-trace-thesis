\newcommand*\sttstent[2]{\{\fv{val}{#1},\:\fv{sttq}{#2}\}}
\WithSuffix\newcommand\sttstent*[2]{%
  \begin{spreadlines}{0pt}
    \left\{\begin{aligned}
      \field{val} &\colon #1 \\
      \field{sttq} &\colon #2
    \end{aligned}\right\}
  \end{spreadlines}%
}

